# Copy to .env (untracked) and fill in. Variables already in the environment win.
# docker compose reads .env automatically.

# Django signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If empty, a random key is generated once and stored in HDN_STATE_DIR/secret_key.
HDN_SECRET_KEY=

# Password of the Endpoints manager pages (required: without it the manager stays closed)
HDN_MANAGER_PASSWORD=
